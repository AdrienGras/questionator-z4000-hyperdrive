{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "jsx-a11y", "import", "vitest", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "unicorn/filename-case": ["error", { "case": "kebabCase" }],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["../*"],
            "message": "Importer par `@/…` ; `./…` seulement dans le même dossier (docs/CONVENTIONS.md § Arborescence et imports)."
          }
        ]
      }
    ],
    "import/no-unassigned-import": [
      "error",
      { "allow": ["**/*.css", "@testing-library/jest-dom/vitest", "fake-indexeddb/auto"] }
    ]
  },
  "overrides": [
    {
      "files": ["e2e/screenshots/**"],
      "rules": { "no-restricted-imports": "off" }
    },
    {
      "files": ["src/routes/**"],
      "rules": { "unicorn/filename-case": "off" }
    },
    {
      "files": [
        "src/domain/config/example.test.ts",
        "src/domain/training/training-example.test.ts",
        "src/features/session/passage-example.test.tsx",
        "src/features/config-editor/hooks/use-config-draft.ts",
        "src/features/config-editor/hooks/use-config-draft.test.ts",
        "src/features/config-editor/hooks/use-live-validation.test.ts"
      ],
      "rules": { "no-restricted-imports": "off" }
    }
  ],
  "ignorePatterns": ["dist", "coverage", "src/routeTree.gen.ts", "src/components/ui"]
}
