{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["es2023"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    // `@/*` est requis par site/guide/*.test.ts, qui importe des modules de src/. Ils doivent rester
    // sans dépendance au DOM : ce projet n'a pas la lib "dom".
    "paths": { "@/*": ["./src/*"] }
  },
  "include": [
    "vite.config.ts",
    "vite",
    "scripts",
    "site/.vitepress/**/*.ts",
    "site/guide/*.test.ts"
  ]
}
