{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/scripts/rotate-memory.sh > .git/memory-rotated 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "MEMORY_ROTATED=\"$(cat .git/memory-rotated 2>/dev/null)\"; rm -f .git/memory-rotated; export MEMORY_ROTATED; .claude/hooks/load-memory.sh"
          }
        ]
      }
    ]
  }
}
